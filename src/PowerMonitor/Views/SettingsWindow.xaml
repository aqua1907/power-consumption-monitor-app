<Window
    x:Class="PowerMonitor.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Power monitor settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Power monitor" />

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="640"
                Margin="20,8,20,20"
                Spacing="8">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock
                    Style="{StaticResource SecondaryCaptionStyle}"
                    Text="Read only. The monitor never changes inverter settings."
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Connection" />
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ProtocolBox"
                                HorizontalAlignment="Stretch"
                                Header="Protocol"
                                SelectionChanged="ProtocolBox_SelectionChanged">
                                <ComboBoxItem Content="Modbus TCP" />
                                <ComboBoxItem Content="Solarman V5" />
                            </ComboBox>
                            <TextBox
                                x:Name="HostBox"
                                Grid.Column="1"
                                Header="Logger address"
                                PlaceholderText="192.168.1.50" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="PortBox"
                                Header="Port"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="UnitIdBox"
                                Grid.Column="1"
                                Header="Unit ID"
                                Maximum="247"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="OffsetBox"
                                Grid.Column="2"
                                Header="Address offset"
                                Maximum="1"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <NumberBox
                            x:Name="IntervalBox"
                            Header="Update every (seconds)"
                            Maximum="3600"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact" />
                        <TextBox
                            x:Name="SerialBox"
                            Header="Logger serial (Solarman V5 only)"
                            PlaceholderText="Printed on the Wi-Fi stick" />
                        <CheckBox x:Name="InvertToggle" Content="Flip battery power sign" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Find_Click" Content="Find logger" />
                            <Button
                                x:Name="TestButton"
                                Click="Test_Click"
                                Content="Test connection" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Logger firmware 1.7.x uses Modbus TCP on port 502 (enable it on Link 2). Older sticks use Solarman V5 on port 8899 with the stick serial. If the percentage looks wrong, change the offset. If charging and discharging are swapped, flip the sign."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Battery" />
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="ReserveBox"
                                Header="Reserve %"
                                Maximum="90"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="PacksBox"
                                Grid.Column="1"
                                Header="Packs"
                                Maximum="64"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="BaselineBox"
                                Grid.Column="2"
                                Header="PC baseline W"
                                Maximum="2000"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <NumberBox
                            x:Name="LowSocThresholdBox"
                            Header="Low battery alert threshold %"
                            Maximum="90"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Each SE-G5.1 Pro-B pack holds 5.12 kWh. Backup time uses the home load and stops at the reserve. PC power is an estimate and is not used for backup time. The alert threshold also turns the tray icon and dashboard red."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Outage schedule" />
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <CheckBox
                            x:Name="ScheduleToggle"
                            Content="Warn me before scheduled outages and compare them with real ones" />
                        <ComboBox
                            x:Name="ScheduleOperatorBox"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            Header="Operator" />
                        <AutoSuggestBox
                            x:Name="StreetBox"
                            Header="Street"
                            PlaceholderText="Type at least 3 letters, for example Хрещатик"
                            SuggestionChosen="StreetBox_SuggestionChosen"
                            TextChanged="StreetBox_TextChanged"
                            TextMemberPath="Label">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <AutoSuggestBox
                            x:Name="HouseBox"
                            Header="House number"
                            IsEnabled="False"
                            PlaceholderText="Pick a street first, then type the number"
                            SuggestionChosen="HouseBox_SuggestionChosen"
                            TextChanged="HouseBox_TextChanged"
                            TextMemberPath="Label">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <TextBlock
                            x:Name="ScheduleGroupText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <NumberBox
                            x:Name="ScheduleLeadBox"
                            Header="Notify before an outage (minutes)"
                            Maximum="720"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact" />
                        <CheckBox
                            x:Name="ScheduleChangeToggle"
                            Content="Notify when a new schedule is published or changed" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="The street and house you type are sent to the operator's schedule service (app.yasno.ua) while you search. Only the address label and the group are saved, on this PC. The schedule itself is read every 15 minutes and kept for 30 days so it can be compared with the outages this app records."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Windows" />
                <Border Padding="16,8" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <CheckBox x:Name="StartupToggle" Content="Start with Windows" />
                        <CheckBox x:Name="GridNotificationToggle" Content="Notify when the grid drops" />
                        <CheckBox x:Name="SocNotificationToggle" Content="Notify when the battery is low" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Backup play mode" />
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <CheckBox
                            x:Name="BackupPlayToggle"
                            Content="When the grid drops, switch WoW: Forever to low power" />
                        <TextBox
                            x:Name="WowConfigPathBox"
                            Header="WoW Forever Config.wtf"
                            PlaceholderText="D:\Games\Battle.net\World of Warcraft\_forever_\WTF\Config.wtf" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="BackupHzBox"
                                Header="Backup display Hz"
                                Maximum="240"
                                Minimum="60"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="GridHzBox"
                                Grid.Column="1"
                                Header="Grid display Hz"
                                Maximum="360"
                                Minimum="60"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <CheckBox
                            x:Name="GpuPowerToggle"
                            Content="Also change the RTX 4090 power limit" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="BackupGpuWattsBox"
                                Header="Backup GPU W"
                                Maximum="600"
                                Minimum="150"
                                SpinButtonPlacementMode="Compact" />
                            <NumberBox
                                x:Name="GridGpuWattsBox"
                                Grid.Column="1"
                                Header="Grid GPU W"
                                Maximum="600"
                                Minimum="150"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="InstallGpuHelper_Click" Content="Install GPU power helper" />
                            <Button Click="ApplyBackupNow_Click" Content="Apply backup now" />
                            <Button Click="ApplyGridNow_Click" Content="Apply grid now" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Display Hz and GPU watts change immediately and apply to every game. WoW: Forever is the only game preset; another title is one IGamePowerProfile added to GameProfiles. WoW graphics load from Config.wtf on restart — restart the game once after an outage starts or ends. The GPU helper needs one admin approval, then outages no longer prompt UAC."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="ResultBar"
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="False" />
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="20,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Cancel_Click" Content="Cancel" />
                <Button
                    Click="Save_Click"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
