<Window
    x:Class="PowerMonitor.Views.FinderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find Deye logger">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Power monitor" />

        <StackPanel
            Grid.Row="1"
            Margin="20,8,20,12"
            Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Find logger" />
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource SecondaryCaptionStyle}"
                Text="Looking for a Deye logger on this network…"
                TextWrapping="Wrap" />
            <ProgressBar
                x:Name="Progress"
                Margin="0,8,0,0"
                IsIndeterminate="True" />
        </StackPanel>

        <ListView
            x:Name="ResultsList"
            Grid.Row="2"
            Margin="12,0"
            IsItemClickEnabled="True"
            ItemClick="ResultsList_ItemClick"
            SelectionChanged="ResultsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding IpAddress}" />
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionStyle}"
                                Text="{Binding Source}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{Binding Port}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource TertiaryCaptionStyle}"
                                Text="{Binding Serial}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="3"
            Padding="20,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Close_Click" Content="Close" />
                <Button
                    x:Name="UseButton"
                    Click="Use_Click"
                    Content="Use this logger"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
