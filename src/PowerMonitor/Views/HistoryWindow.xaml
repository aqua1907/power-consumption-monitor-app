<Window
    x:Class="PowerMonitor.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Power monitor history">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Power monitor" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,8,20,20" Spacing="8">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="History" />

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Outages" />
                <TextBlock
                    Style="{StaticResource SecondaryCaptionStyle}"
                    Text="Grid-loss events this app has observed, with when they started, ended, and how long they lasted."
                    TextWrapping="Wrap" />
                <Border Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <TextBlock
                            x:Name="OutagesEmptyText"
                            Margin="16"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="No outages recorded yet." />
                        <ListView
                            x:Name="OutagesList"
                            MaxHeight="260"
                            Padding="4"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Style="{StaticResource TertiaryCaptionStyle}"
                                                Text="Started" />
                                            <TextBlock
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{Binding Started}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Style="{StaticResource TertiaryCaptionStyle}"
                                                Text="Ended" />
                                            <TextBlock
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{Binding Ended}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource TertiaryCaptionStyle}"
                                                Text="Duration" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{Binding Duration}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Export" />
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Save the retained battery and load history (up to the last 24 hours) as a CSV file for offline analysis."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ExportButton"
                            Click="Export_Click"
                            Content="Save power history as CSV…" />
                        <TextBlock
                            x:Name="ExportResultText"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="20,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Click="Close_Click" Content="Close" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
