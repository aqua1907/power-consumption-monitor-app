<UserControl
    x:Class="PowerMonitor.Controls.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,0,2" Spacing="8">
            <Grid Padding="4,0,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource TertiaryCaptionStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Refresh the schedule"
                    Click="Refresh_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Refresh the schedule">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="NoticeBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <StackPanel x:Name="DaysPanel" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
