<UserControl
    x:Class="PowerMonitor.Controls.PowerHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="RangeRow"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="4" />

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,4,0">
            <TextBlock
                x:Name="MaxLabel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource TertiaryCaptionStyle}" />
            <TextBlock
                x:Name="ZeroLabel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource TertiaryCaptionStyle}"
                Text="0 W" />
            <TextBlock
                x:Name="MinLabel"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource TertiaryCaptionStyle}" />
        </Grid>

        <Grid
            x:Name="PlotArea"
            Grid.Row="1"
            Grid.Column="1"
            Background="Transparent"
            PointerExited="PlotArea_PointerExited"
            PointerMoved="PlotArea_PointerMoved"
            PointerPressed="PlotArea_PointerMoved">
            <Canvas x:Name="Plot">
                <Polygon
                    x:Name="ChargeArea"
                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                    Opacity="0.4" />
                <Polygon
                    x:Name="DischargeArea"
                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                    Opacity="0.4" />
                <Line
                    x:Name="ZeroLine"
                    Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                    StrokeThickness="1" />
                <Polyline
                    x:Name="BatteryLine"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeLineJoin="Round"
                    StrokeThickness="1.5" />
                <Line
                    x:Name="CrosshairLine"
                    Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                    StrokeDashArray="2,2"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="CrosshairDot"
                    Width="6"
                    Height="6"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="Collapsed" />
                <Border
                    x:Name="TooltipBorder"
                    Padding="6,3"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock x:Name="TooltipText" Style="{StaticResource TertiaryCaptionStyle}" />
                </Border>
            </Canvas>
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource TertiaryCaptionStyle}"
                Text="Collecting readings…" />
        </Grid>

        <TextBlock
            x:Name="StartTimeLabel"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            Style="{StaticResource TertiaryCaptionStyle}" />
        <TextBlock
            x:Name="EndTimeLabel"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,2,0,0"
            HorizontalAlignment="Right"
            Style="{StaticResource TertiaryCaptionStyle}" />
    </Grid>
</UserControl>
