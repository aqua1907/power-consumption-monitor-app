<UserControl
    x:Class="PowerMonitor.Controls.PowerHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="Plot">
            <Polygon
                x:Name="ChargeArea"
                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                Opacity="0.4" />
            <Polygon
                x:Name="DischargeArea"
                Fill="{ThemeResource SystemFillColorCautionBrush}"
                Opacity="0.4" />
            <Line
                x:Name="ZeroLine"
                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                StrokeThickness="1" />
            <Polyline
                x:Name="BatteryLine"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeLineJoin="Round"
                StrokeThickness="1.5" />
        </Canvas>
        <TextBlock
            x:Name="EmptyText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource TertiaryCaptionStyle}"
            Text="Collecting readings…" />
    </Grid>
</UserControl>
